#!/usr/bin/env python3
"""bugbuster — turn newly opened GitHub issues into a local ticket queue for coding agents.

A background listener runs `gh webhook forward` (GitHub's own webhook forwarding
service: authenticated, outbound-only, no open ports, no tunnel) and spools every
newly opened issue to ~/.bugbuster/queue/<repo>/ as one JSON file per ticket.

Commands (path defaults to the current directory; must be inside a git clone of
the GitHub repo to watch):
  bugbuster wait   [path]   ensure the listener runs, block until a ticket is
                            queued, print it as JSON on stdout, exit 0
  bugbuster listen [path]   start the listener only
  bugbuster stop   [path]   stop the listener and delete the forwarding webhook
  bugbuster stop-owned      stop every listener owned by the claude/codex
                            process this command descends from (SessionEnd hook)
  bugbuster status          list listeners and queue depths

Ownership: wait/listen record the claude/codex ancestor PID as the listener's
owner. The listener watches that PID and, when it dies (session exit, terminal
closed, crash), deletes the forwarding webhook and stops itself.
"""
import fcntl
import json
import os
import signal
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~/.bugbuster")


def die(msg, code=1):
    print(f"bugbuster: {msg}", file=sys.stderr)
    sys.exit(code)


def log(msg):
    print(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}", flush=True)


def repo_slug(path):
    r = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"{path} is not inside a git repository")
    top = r.stdout.strip()
    r = subprocess.run(
        ["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"],
        cwd=top, capture_output=True, text=True)
    if r.returncode != 0:
        die(f"cannot resolve the GitHub repo for {top}: {r.stderr.strip()}")
    return r.stdout.strip()


def paths_for(slug):
    safe = slug.replace("/", "__")
    queue = os.path.join(HOME, "queue", safe)
    pidfile = os.path.join(HOME, "run", f"{safe}.pid")
    logfile = os.path.join(HOME, "log", f"{safe}.log")
    for d in (queue, os.path.dirname(pidfile), os.path.dirname(logfile)):
        os.makedirs(d, exist_ok=True)
    return queue, pidfile, logfile


def owner_file(pidfile):
    return pidfile[:-4] + ".owner"


def agent_ancestor():
    """PID of the claude/codex process this run descends from, if any."""
    pid = os.getpid()
    for _ in range(25):
        r = subprocess.run(["ps", "-o", "ppid=,command=", "-p", str(pid)],
                           capture_output=True, text=True)
        parts = r.stdout.split(None, 1) if r.returncode == 0 else []
        if len(parts) < 2:
            return None
        ppid, command = int(parts[0]), parts[1]
        head = os.path.basename(command.split()[0])
        if head in ("claude", "codex") or (head.startswith("node") and "claude" in command):
            return pid
        if ppid <= 1:
            return None
        pid = ppid
    return None


def record_owner(pidfile):
    own = agent_ancestor()
    if own:
        with open(owner_file(pidfile), "w") as f:
            f.write(str(own))


def delete_cli_hooks(slug, report):
    r = subprocess.run(["gh", "api", f"repos/{slug}/hooks",
                        "--jq", '.[] | select(.name=="cli") | .id'],
                       capture_output=True, text=True)
    if r.returncode != 0:
        report(f"could not list webhooks on {slug}: {r.stderr.strip()}")
        return
    for hook_id in r.stdout.split():
        d = subprocess.run(["gh", "api", "-X", "DELETE",
                            f"repos/{slug}/hooks/{hook_id}"],
                           capture_output=True, text=True)
        if d.returncode == 0:
            report(f"removed forwarding webhook {hook_id}")
        else:
            report(f"failed to remove webhook {hook_id}: {d.stderr.strip()}")


def listener_pid(pidfile):
    try:
        pid = int(open(pidfile).read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def start_listener(slug):
    _, pidfile, logfile = paths_for(slug)
    # flock so two concurrent wait/listen calls can't both spawn a listener
    with open(pidfile + ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if listener_pid(pidfile):
            return False
        with open(logfile, "ab") as logf:
            p = subprocess.Popen(
                [sys.executable, os.path.abspath(__file__), "_serve", slug],
                stdout=logf, stderr=logf, start_new_session=True)
        with open(pidfile, "w") as f:
            f.write(str(p.pid))
        # reap on exit so a dead _serve never lingers as a zombie that
        # os.kill(pid, 0) would misreport as alive (silent-hang bug)
        threading.Thread(target=p.wait, daemon=True).start()
        time.sleep(3)  # let gh webhook forward create/activate the hook
        if p.poll() is not None:
            os.remove(pidfile)
            die(f"listener failed to start — see {logfile}")
    return True


def cmd_listen(path):
    slug = repo_slug(path)
    state = "started" if start_listener(slug) else "already running"
    record_owner(paths_for(slug)[1])
    print(f"bugbuster: listener {state} for {slug}", file=sys.stderr)


def cmd_wait(path):
    slug = repo_slug(path)
    queue, pidfile, logfile = paths_for(slug)
    start_listener(slug)
    record_owner(pidfile)
    print(f"bugbuster: watching {slug} for new issues "
          f"({len(os.listdir(queue))} queued). Blocking until one arrives…",
          file=sys.stderr)
    while True:
        files = sorted(f for f in os.listdir(queue) if f.endswith(".json"))
        if files:
            fpath = os.path.join(queue, files[0])
            data = open(fpath).read()
            os.remove(fpath)
            print(data)
            return
        if not listener_pid(pidfile):
            die(f"listener died — see {logfile}")
        time.sleep(1)  # ponytail: 1s poll on a local dir; fs events if it ever matters


def stop_one(slug, pidfile, report):
    pid = listener_pid(pidfile)
    if pid:
        try:
            os.killpg(pid, signal.SIGTERM)  # _serve leads its own group; takes gh with it
        except OSError:
            pass
        report(f"listener stopped for {slug}")
    else:
        report(f"no listener running for {slug}")
    for f in (pidfile, owner_file(pidfile)):
        try:
            os.remove(f)
        except OSError:
            pass
    delete_cli_hooks(slug, report)


def cmd_stop(path):
    slug = repo_slug(path)
    _, pidfile, _ = paths_for(slug)
    stop_one(slug, pidfile, lambda m: print(f"bugbuster: {m}", file=sys.stderr))


def cmd_stop_owned():
    """SessionEnd hook / watchdog twin: stop every listener owned by MY agent
    ancestor. Always exits 0 — a session-end hook must never block shutdown."""
    me = agent_ancestor()
    rundir = os.path.join(HOME, "run")
    if not me or not os.path.isdir(rundir):
        return
    for f in sorted(os.listdir(rundir)):
        if not f.endswith(".pid"):
            continue
        pidfile = os.path.join(rundir, f)
        try:
            owner = int(open(owner_file(pidfile)).read().strip())
        except (OSError, ValueError):
            continue
        if owner != me:
            continue
        slug = f[:-4].replace("__", "/")
        stop_one(slug, pidfile, lambda m: print(f"bugbuster: {m} (session ended)"))


def cmd_status():
    rundir = os.path.join(HOME, "run")
    entries = sorted(f for f in os.listdir(rundir)
                     if f.endswith(".pid")) if os.path.isdir(rundir) else []
    if not entries:
        print("no listeners")
        return
    for f in entries:
        safe = f[:-4]
        pidfile = os.path.join(rundir, f)
        pid = listener_pid(pidfile)
        queue = os.path.join(HOME, "queue", safe)
        n = len(os.listdir(queue)) if os.path.isdir(queue) else 0
        state = f"running (pid {pid})" if pid else "dead"
        try:
            state += f", owner {int(open(owner_file(pidfile)).read().strip())}"
        except (OSError, ValueError):
            pass
        print(f"{safe.replace('__', '/')}: {state}, {n} ticket(s) queued")


def _owner_watch(slug, pidfile):
    """Self-destruct when the owning agent process dies (terminal closed,
    session crashed): delete the forwarding webhook, then stop this listener."""
    ofile = owner_file(pidfile)
    while True:
        time.sleep(5)
        try:
            owner = int(open(ofile).read().strip())
        except (OSError, ValueError):
            continue  # no owner recorded: plain CLI listener, runs until stopped
        try:
            os.kill(owner, 0)
        except OSError:
            log(f"owner process {owner} is gone; removing webhook and stopping")
            delete_cli_hooks(slug, log)
            for f in (pidfile, ofile):
                try:
                    os.remove(f)
                except OSError:
                    pass
            os.killpg(os.getpid(), signal.SIGTERM)


def cmd_serve(slug):
    queue, pidfile, _ = paths_for(slug)
    threading.Thread(target=_owner_watch, args=(slug, pidfile), daemon=True).start()
    fails = 0
    ok_once = False  # has gh ever run long enough to be considered healthy?
    while True:
        started = time.time()
        p = subprocess.Popen(
            ["gh", "webhook", "forward", "--events=issues", f"--repo={slug}"],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        log(f"gh webhook forward started (pid {p.pid}) for {slug}")
        for line in p.stdout:
            line = line.strip()
            if not line.startswith("{"):
                if line:
                    log(f"gh: {line}")
                continue
            try:
                payload = json.loads(line)
            except ValueError:
                log(f"unparseable event line: {line[:200]}")
                continue
            issue = payload.get("issue")
            if payload.get("action") != "opened" or not issue:
                log(f"ignoring issues event action={payload.get('action')}")
                continue
            ticket = {
                "repo": slug,
                "number": issue["number"],
                "title": issue["title"],
                "body": issue.get("body") or "",
                "html_url": issue["html_url"],
                "labels": [l["name"] for l in issue.get("labels", [])],
                "author": issue.get("user", {}).get("login", ""),
                "created_at": issue.get("created_at", ""),
            }
            fname = os.path.join(queue,
                                 f"{int(time.time() * 1000):013d}-{issue['number']:010d}.json")
            with open(fname + ".tmp", "w") as f:
                json.dump(ticket, f, indent=1)
            os.rename(fname + ".tmp", fname)  # atomic: wait never sees half a ticket
            log(f"queued issue #{issue['number']}: {issue['title']}")
        rc = p.wait()
        # gh exited (network blip, laptop sleep). Restart with backoff — but a
        # failure before gh EVER ran healthily is a setup error (bad perms,
        # bad flags): die loudly so start_listener's 3s check surfaces it.
        if time.time() - started >= 30:
            ok_once, fails = True, 0
        else:
            fails += 1
        if not ok_once:
            log(f"gh webhook forward failed at startup (rc={rc}); giving up")
            sys.exit(1)
        if fails >= 10:  # ~8+ min of consecutive instant failures
            log(f"gh webhook forward keeps failing (rc={rc}); giving up")
            sys.exit(1)
        delay = min(5 * (2 ** fails), 60) if fails else 5
        log(f"gh webhook forward exited rc={rc}; restarting in {delay}s")
        time.sleep(delay)


def main():
    args = sys.argv[1:]
    known = ("wait", "listen", "stop", "stop-owned", "status", "_serve")
    cmd = args[0] if args and args[0] in known else "wait"
    rest = args[1:] if args and args[0] in known else args
    if cmd == "status":
        return cmd_status()
    if cmd == "stop-owned":
        return cmd_stop_owned()
    if cmd == "_serve":
        return cmd_serve(rest[0])
    path = os.path.abspath(rest[0]) if rest else os.getcwd()
    {"wait": cmd_wait, "listen": cmd_listen, "stop": cmd_stop}[cmd](path)


if __name__ == "__main__":
    main()
